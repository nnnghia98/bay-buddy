# .env.example – Copy to .env and fill in real values.
# Never commit the real .env file to source control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Development (SQLite – auto-created on startup):
DATABASE_URL=sqlite:///./bay_buddy.db

# Production (PostgreSQL example):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/bay_buddy

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=2880

# Passcodes are bcrypt-hashed in the user table. Do not add passcodes or
# usernames to this file.

# ---------------------------------------------------------------------------
# AI – Gemini API
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ---------------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins.
# FRONTEND_URL_REGEX defaults to localhost, private LAN, and Tailscale dev origins
# on ports 3000 and 6769. Override it to tighten or expand dev access.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:6769,http://127.0.0.1:6769
# FRONTEND_URL_REGEX=^http://100\.81\.220\.45:6769$

# ---------------------------------------------------------------------------
# Debug / Logging
# ---------------------------------------------------------------------------
# Set to "true" to echo SQL queries in the console
SQL_ECHO=false
